#!/usr/bin/env bash
s=org.gnome.desktop.interface
theme=$(gsettings get $s gtk-theme | tr -d "'")
[ -z "$theme" ] && theme="Adwaita-dark"

gsettings set $s gtk-theme "gtk-reload-dummy"
gsettings set $s gtk-theme "$theme"

