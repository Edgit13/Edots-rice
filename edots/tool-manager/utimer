#!/usr/bin/env bash
# utimer — фонові таймери й нагадування: за тривалістю (10m, 1h30m) АБО на конкретну дату й час (10.26.2026 13:00).
#
#   utimer start <час|дата [час]> [повідомлення…]
#   utimer at    <дата> [час] [повідомлення…]      (те саме, що start)
#   utimer list [--json]                            активні таймери
#   utimer cancel <id|all>                          скасувати
#   utimer restore                                  після входу/перезапуску: заново запустити очікування
#
# Таймери зберігаються у ~/.local/state/edots/timers.jsonl — його читає дашборд (календар, планувальник).
# Залежності: bash, GNU date, flock; для сигналу — notify-send + mpv | pw-play | paplay.

set -u

BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m'
if [ ! -t 1 ]; then BLUE=''; GREEN=''; RED=''; YELLOW=''; NC=''; fi

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/edots"
STORE="$STATE_DIR/timers.jsonl"
LOCK="$STATE_DIR/timers.lock"
PIDS="$STATE_DIR/timers"
DEFAULT_MSG="Your timer has finished!"
DEFAULT_TIME="09:00"            # коли вказана лише дата

# --- звуковий файл: поруч зі скриптом (з урахуванням symlink), далі типові місця ---
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
AUDIO_FILE=""
for cand in "$SELF_DIR/timer-end.mp3" "$HOME/edots/tool-manager/timer-end.mp3" "$HOME/Dotfiles/edots/tool-manager/timer-end.mp3"; do
  [ -f "$cand" ] && { AUDIO_FILE="$cand"; break; }
done

mkdir -p "$STATE_DIR" "$PIDS"
touch "$STORE"

die() { echo -e "${RED}Error: $*${NC}" >&2; exit 1; }

show_help() {
  echo -e "${BLUE}Background Timer Utility (utimer)${NC}"
  echo "Usage: utimer <command> [args]"
  echo ""
  echo "Commands:"
  echo "  start <time> [msg]            Timer by duration:   30s, 10m, 2h, 1h30m, 1d"
  echo "  start <date> [HH:MM] [msg]    Timer at a date/time: 10.26.2026 13:00"
  echo "  at    <date> [HH:MM] [msg]    Alias of the above"
  echo "  list [--json]                 Show active timers"
  echo "  cancel <id|all>               Cancel a timer"
  echo "  restore                       Re-arm timers after login / reboot"
  echo "  help                          Show this help"
  echo ""
  echo "Dates:  MM.DD.YYYY  MM/DD/YYYY  YYYY-MM-DD  (DD.MM.YYYY if the first number is > 12),"
  echo "        today / tomorrow.  Time defaults to $DEFAULT_TIME when omitted."
  echo "Quote or not:  utimer start 10.26.2026 13:00 \"Call mom\"   ==   utimer start \"10.26.2026 13:00\" \"Call mom\""
}

# ------------------------------------------------------------------ парсинг часу
# "1h30m" → секунди. Просте число = секунди.
parse_duration() {
  local s="${1,,}" total=0 n u
  [[ "$s" =~ ^([0-9]+[smhdw]?)+$ ]] || return 1
  while [[ "$s" =~ ^([0-9]+)([smhdw]?)(.*)$ ]]; do
    n=${BASH_REMATCH[1]}; u=${BASH_REMATCH[2]}; s=${BASH_REMATCH[3]}
    case "$u" in
      ""|s) total=$((total + n)) ;;
      m)    total=$((total + n * 60)) ;;
      h)    total=$((total + n * 3600)) ;;
      d)    total=$((total + n * 86400)) ;;
      w)    total=$((total + n * 604800)) ;;
    esac
  done
  echo "$total"
}

is_date_token() {
  local t="${1,,}"
  [[ "$t" =~ ^[0-9]{1,2}[./][0-9]{1,2}[./][0-9]{4}$ ]] && return 0
  [[ "$t" =~ ^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$ ]] && return 0
  [[ "$t" == today || "$t" == tomorrow ]] && return 0
  return 1
}
is_time_token() { [[ "$1" =~ ^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$ ]]; }

# date-токен + time-токен → epoch (stdout); код 1 — неправильна дата/час
to_epoch() {
  local d="${1,,}" t="${2:-$DEFAULT_TIME}" y m day a b iso
  case "$d" in
    today)    iso="$(date +%F)" ;;
    tomorrow) iso="$(date -d tomorrow +%F)" ;;
    *)
      if [[ "$d" =~ ^([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})$ ]]; then
        y=${BASH_REMATCH[1]}; m=${BASH_REMATCH[2]}; day=${BASH_REMATCH[3]}
      elif [[ "$d" =~ ^([0-9]{1,2})[./]([0-9]{1,2})[./]([0-9]{4})$ ]]; then
        a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}; y=${BASH_REMATCH[3]}
        # MM.DD.YYYY за замовчуванням; якщо перше число > 12 — це DD.MM.YYYY
        if (( 10#$a > 12 )); then day=$a; m=$b; else m=$a; day=$b; fi
      else
        return 1
      fi
      printf -v iso '%04d-%02d-%02d' "$y" "$((10#$m))" "$((10#$day))"
      ;;
  esac
  [[ "$t" =~ ^([0-9]{1,2}):([0-9]{2})(:([0-9]{2}))?$ ]] || return 1
  local hh=${BASH_REMATCH[1]} mm=${BASH_REMATCH[2]} ss=${BASH_REMATCH[4]:-00}
  (( 10#$hh < 24 && 10#$mm < 60 && 10#$ss < 60 )) || return 1
  printf -v t '%02d:%02d:%02d' "$((10#$hh))" "$((10#$mm))" "$((10#$ss))"
  local ep
  ep="$(date -d "$iso $t" +%s 2>/dev/null)" || return 1
  # перевірка «2026-02-30»: дата після round-trip має збігтися
  [ "$(date -d "@$ep" +%F)" = "$iso" ] || return 1
  echo "$ep"
}

# ------------------------------------------------------------------ сховище (JSON Lines)
json_escape() {
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/\\t}
  printf '%s' "$s"
}
new_id() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-6; }

store_add() {   # id at message
  local line
  line="{\"id\":\"$1\",\"at\":$2,\"message\":\"$(json_escape "$3")\",\"created\":$(date +%s),\"state\":\"pending\"}"
  ( flock 9; printf '%s\n' "$line" >>"$STORE" ) 9>"$LOCK"
}
store_remove() {  # id
  ( flock 9; sed -i "/\"id\":\"$1\"/d" "$STORE" ) 9>"$LOCK"
  rm -f "$PIDS/$1.pid"
}
store_state() {   # id state
  ( flock 9; sed -i "/\"id\":\"$1\"/s/\"state\":\"[a-z]*\"/\"state\":\"$2\"/" "$STORE" ) 9>"$LOCK"
}
store_has() { grep -q "\"id\":\"$1\"" "$STORE" 2>/dev/null; }
store_line() { grep -m1 "\"id\":\"$1\"" "$STORE" 2>/dev/null; }
field_num() { sed -n "s/.*\"$2\":\([0-9]*\).*/\1/p" <<<"$1"; }
field_msg() {   # розекранувати message
  local m
  m="$(sed -n 's/.*"message":"\(.*\)","created".*/\1/p' <<<"$1")"
  m=${m//\\n/$'\n'}; m=${m//\\t/$'\t'}; m=${m//\\\"/\"}; m=${m//\\\\/\\}
  printf '%s' "$m"
}

# ------------------------------------------------------------------ очікування й сигнал
spawn_waiter() {   # id
  setsid nohup bash "$SELF" _wait "$1" >/dev/null 2>&1 &
  echo $! >"$PIDS/$1.pid"
}

waiter_alive() {
  local pid
  pid="$(cat "$PIDS/$1.pid" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && grep -qa "_wait" "/proc/$pid/cmdline" 2>/dev/null
}

do_wait() {   # id — працює у фоні
  local id="$1" line at msg now rem late=0
  line="$(store_line "$id")" || exit 0
  at="$(field_num "$line" at)"
  msg="$(field_msg "$line")"
  [ -z "$msg" ] && msg="$DEFAULT_MSG"

  LOOP_PID=""; NOTIFY_PID=""
  cleanup() {
    [ -n "$LOOP_PID" ] && { pkill -P "$LOOP_PID" 2>/dev/null; kill "$LOOP_PID" 2>/dev/null; }
    [ -n "$NOTIFY_PID" ] && kill "$NOTIFY_PID" 2>/dev/null
  }
  trap 'exit 0' TERM INT
  trap cleanup EXIT

  # чекаємо за настінним годинником (кроками по ≤30 с — переживає suspend)
  while :; do
    store_has "$id" || exit 0                 # скасовано
    now=$(date +%s); rem=$((at - now))
    (( rem <= 0 )) && break
    sleep $(( rem > 30 ? 30 : rem ))
  done
  (( $(date +%s) - at > 60 )) && late=1        # запізнилися (комп'ютер був вимкнений/у сні)
  store_has "$id" || exit 0

  store_state "$id" ringing
  if (( late )); then msg="$msg  (⏰ $(date -d "@$at" '+%m.%d.%Y %H:%M'))"; fi

  if [ -n "$AUDIO_FILE" ]; then
    ( while true; do
        mpv --no-video --no-terminal "$AUDIO_FILE" 2>/dev/null || \
        pw-play "$AUDIO_FILE" 2>/dev/null || \
        paplay "$AUDIO_FILE" 2>/dev/null || break
      done ) &
    LOOP_PID=$!
  fi

  # чекаємо, поки користувач закриє сповіщення
  notify-send -u critical -i clock "Timer Complete" "$msg" --wait &
  NOTIFY_PID=$!
  wait "$NOTIFY_PID" 2>/dev/null
  store_remove "$id"
  exit 0
}

# ------------------------------------------------------------------ команди
cmd_start() {
  [ $# -ge 1 ] || die "Specify a duration (30s, 10m, 1h30m) or a date (10.26.2026 13:00)."
  local first="$1"; shift
  local at="" when_label=""

  # "10.26.2026 13:00" одним аргументом у лапках
  if [[ "$first" == *" "* ]]; then
    local d_part t_part
    read -r d_part t_part <<<"$first"
    if is_date_token "$d_part"; then
      first="$d_part"
      if [ -n "${t_part:-}" ]; then set -- "$t_part" "$@"; fi
    fi
  fi

  if is_date_token "$first"; then
    local tm=""
    if [ $# -ge 1 ] && is_time_token "$1"; then tm="$1"; shift; fi
    at="$(to_epoch "$first" "$tm")" || die "Invalid date/time: '$first ${tm}'. Use e.g. 10.26.2026 13:00"
    (( at > $(date +%s) )) || die "That moment is already in the past ($(date -d "@$at" '+%m.%d.%Y %H:%M'))."
  else
    local secs
    secs="$(parse_duration "$first")" || die "Unknown time '$first'. Use 30s, 10m, 2h, 1h30m or a date like 10.26.2026 13:00."
    (( secs > 0 )) || die "Duration must be greater than zero."
    at=$(( $(date +%s) + secs ))
  fi
  when_label="$(date -d "@$at" '+%m.%d.%Y %H:%M:%S')"

  local msg="${*:-$DEFAULT_MSG}"
  local id; id="$(new_id)"
  store_add "$id" "$at" "$msg"
  spawn_waiter "$id"

  if [ -t 1 ]; then
    echo -e "${GREEN}==> Timer $id set for $when_label${NC}"
    echo -e "${BLUE}Runs in background; you'll get a notification (and a sound) when it's up.${NC}"
  else
    echo "id=$id at=$at"          # для скриптів / дашборду
  fi
}

human_remaining() {
  local s=$1 d h m
  (( s < 0 )) && s=0
  d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
  if (( d > 0 )); then printf '%dd %dh' "$d" "$h"
  elif (( h > 0 )); then printf '%dh %dm' "$h" "$m"
  elif (( m > 0 )); then printf '%dm %ds' "$m" "$((s % 60))"
  else printf '%ds' "$s"; fi
}

cmd_list() {
  if [ "${1:-}" = "--json" ]; then
    printf '['; paste -sd, "$STORE" 2>/dev/null | tr -d '\n'; printf ']\n'
    return 0
  fi
  if [ ! -s "$STORE" ]; then echo "No active timers."; return 0; fi
  printf "${BLUE}%-8s %-17s %-10s %s${NC}\n" "ID" "WHEN" "IN" "MESSAGE"
  local now line id at msg st
  now=$(date +%s)
  sort -t: -k3 -n "$STORE" | while IFS= read -r line; do
    id="$(sed -n 's/.*"id":"\([^"]*\)".*/\1/p' <<<"$line")"
    at="$(field_num "$line" at)"
    st="$(sed -n 's/.*"state":"\([a-z]*\)".*/\1/p' <<<"$line")"
    msg="$(field_msg "$line")"
    printf "%-8s %-17s %-10s %s\n" "$id" "$(date -d "@$at" '+%m.%d.%Y %H:%M')" \
      "$([ "$st" = ringing ] && echo ringing || human_remaining $((at - now)))" "${msg//$'\n'/ }"
  done
}

cmd_cancel() {
  [ $# -ge 1 ] || die "Usage: utimer cancel <id|all>"
  local id ids
  if [ "$1" = "all" ]; then
    ids="$(sed -n 's/.*"id":"\([^"]*\)".*/\1/p' "$STORE")"
  else
    ids="$1"
  fi
  local n=0
  for id in $ids; do
    if store_has "$id"; then
      store_remove "$id"
      pkill -f -- "_wait $id\$" 2>/dev/null
      n=$((n + 1))
    else
      [ "$1" = "all" ] || die "No timer with id '$id'."
    fi
  done
  if [ -t 1 ]; then echo -e "${GREEN}==> Cancelled $n timer(s).${NC}"; else echo "cancelled=$n"; fi
}

cmd_restore() {
  local line id n=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    id="$(sed -n 's/.*"id":"\([^"]*\)".*/\1/p' <<<"$line")"
    [ -n "$id" ] || continue
    if ! waiter_alive "$id"; then spawn_waiter "$id"; n=$((n + 1)); fi
  done <"$STORE"
  if [ -t 1 ]; then echo -e "${GREEN}==> Re-armed $n timer(s).${NC}"; else echo "restored=$n"; fi
}

COMMAND="${1:-}"
[ $# -gt 0 ] && shift

case "$COMMAND" in
  start|at)         cmd_start "$@" ;;
  list|ls)          cmd_list "$@" ;;
  cancel|rm|stop)   cmd_cancel "$@" ;;
  restore)          cmd_restore ;;
  _wait)            do_wait "$@" ;;
  help|--help|-h|"") show_help; [ -z "$COMMAND" ] && exit 1 ;;
  *)                echo -e "${RED}Error: Unknown command '$COMMAND'.${NC}" >&2; show_help; exit 1 ;;
esac
