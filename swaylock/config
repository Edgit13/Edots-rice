# ==========================================
# GENERAL & BEHAVIOR
# ==========================================
daemonize
show-failed-attempts
clock
indicator
grace=2
grace-no-mouse
grace-no-touch
fade-in=0.2

# ==========================================
# BACKGROUND & EFFECTS
# ==========================================
# This now points to a symlink (shortcut) that we will create in Step 2
image=~/.config/swaylock/current-wallpaper

effect-blur=7x5
effect-vignette=0.5:0.5
color=1f1d2e80

# ==========================================
# TYPOGRAPHY
# ==========================================
font="Inter"
datestr=%a, %B %e
timestr=%I:%M %p

# ==========================================
# INDICATOR GEOMETRY
# ==========================================
indicator-radius=160
indicator-thickness=15

# ==========================================
# ROSÉ PINE COLOR SCHEME
# ==========================================
inside-color=1f1d2eCC
ring-color=191724
line-color=00000000
separator-color=00000000
text-color=e0def4
text-caps-lock-color=f6c177

key-hl-color=c4a7e7
bs-hl-color=ea9a97

inside-ver-color=1f1d2eCC
ring-ver-color=31748f
line-ver-color=00000000
text-ver-color=9ccfd8

inside-wrong-color=1f1d2eCC
ring-wrong-color=eb6f92
line-wrong-color=00000000
text-wrong-color=eb6f92

inside-clear-color=1f1d2eCC
ring-clear-color=9ccfd8
line-clear-color=00000000
text-clear-color=e0def4
