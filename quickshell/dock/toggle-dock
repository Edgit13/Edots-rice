#!/usr/bin/env bash
# M3 dock toggle.
#   dock not running -> starts it (detached), honoring the state file
#   dock running     -> flips the state file: 1 -> 0 (hide), 0 -> 1 (show)
# The dock watches the state file live, so the flip is instant — no restart.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$DIR/state"

if qs -p "$DIR" ipc show >/dev/null 2>&1 || pgrep -f "qs -p $DIR" >/dev/null 2>&1; then
    # Running: flip the state file.
    cur="$(tr -d '[:space:]' < "$STATE" 2>/dev/null || true)"
    if [ "$cur" = "0" ]; then
        echo 1 > "$STATE"
    else
        echo 0 > "$STATE"
    fi
    exit 0
fi

# Not running: default to visible, then start detached.
[ -f "$STATE" ] || echo 1 > "$STATE"
qs -d -p "$DIR"
